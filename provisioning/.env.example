NO_CLOUD_BIND_HOST=0.0.0.0
NO_CLOUD_PORT=8080
SECRET_API_BIND_HOST=0.0.0.0
SECRET_API_PORT=8081
DATABASE_URL=sqlite:////data/provisioning.db
LOG_LEVEL=INFO

TS_API_CLIENT_ID=tskey-client-placeholder
TS_API_CLIENT_SECRET=replace-me
TAILNET_NAME=-

BOOTSTRAP_TAG=tag:bootstrap
BOOTSTRAP_SSH_IMPORT_ID=-
BOOTSTRAP_CAPABILITY=homelab.local/cap/bootstrap
BOOTSTRAP_CAPABILITY_ROLE=bootstrap-client

AUTH_KEY_EXPIRY_MINUTES=10
PROVISIONING_RECORD_TTL_HOURS=24
USER_DATA_REUSE_TTL_SECONDS=120

TAILSCALE_APP_CAPABILITIES_HEADER=Tailscale-App-Capabilities
TS_LOCALAPI_SOCKET=/var/run/tailscale/tailscaled.sock
TS_LOCALAPI_BASE_URL=http://local-tailscaled.sock
TS_LOCALAPI_TIMEOUT_SECONDS=3
TAILSCALE_CLI_PATH=tailscale

SECRET_API_URL=https://secret-api.${TAILNET_NAME}/v1/bootstrap-secrets
UBUNTU_PRO_TOKEN=

BOOTSTRAP_ENV_JSON={"EXAMPLE_TOKEN":"replace-me"}
BOOTSTRAP_FILES_JSON=[{"path":"/etc/example/app.conf","content":"example=true\n"}]
BOOTSTRAP_CONFIG_JSON={"service":"example","mode":"bootstrap"}
